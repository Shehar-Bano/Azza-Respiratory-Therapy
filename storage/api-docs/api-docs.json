    "paths": {
        "/api/user/update-profile": {
            "post": {
                "tags": [
                    "User Profile & Location"
                ],
                "summary": "Update User Profile & Location",
                "description": "Allows users to update their Full Name, Email Address, Phone Number, Profile Image, and saved Google Maps Location with geographic coordinates.",
                "operationId": "d5a091a4fc0545ae2e54579865675540",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Dr. Sarah Jenkins"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "sarah.jenkins@hospital.org"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "+966539301053"
                                    },
                                    "location": {
                                        "type": "string",
                                        "example": "King Fahd Rd, Al Olaya, Riyadh 12211, Saudi Arabia"
                                    },
                                    "city": {
                                        "type": "string",
                                        "example": "Riyadh"
                                    },
                                    "latitude": {
                                        "type": "number",
                                        "format": "double",
                                        "example": 24.713552
                                    },
                                    "longitude": {
                                        "type": "number",
                                        "format": "double",
                                        "example": 46.675296
                                    },
                                    "profile_image": {
                                        "description": "Avatar image (image/jpeg, image/png, max 5MB)",
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Profile updated successfully."
                    },
                    "401": {
                        "description": "Unauthenticated."
                    },
                    "422": {
                        "description": "Validation error."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
