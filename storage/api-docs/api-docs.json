                                        "example": true
                                    },
                                    "channels": {
                                        "properties": {
                                            "General Notification": {
                                                "type": "boolean",
                                                "example": true
                                            },
                                            "Reminder": {
                                                "type": "boolean",
                                                "example": true
                                            },
                                            "Update": {
                                                "type": "boolean",
                                                "example": true
                                            },
                                            "Security Alert": {
                                                "type": "boolean",
                                                "example": true
